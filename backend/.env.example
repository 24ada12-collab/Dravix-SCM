# DRAVIX SCM - Local Backend Environment Configuration
# Copy this file to .env or set environment variables in your local environment.
# DO NOT commit real passwords to Git.

# Server Port
SERVER_PORT=8080

# Database Settings (Local MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/dravix_scm?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
